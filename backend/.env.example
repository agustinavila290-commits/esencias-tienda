SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: True = SQLite (dev), False = PostgreSQL (prod)
USE_SQLITE=True

# PostgreSQL (solo si USE_SQLITE=False)
DB_NAME=esencias
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — separar con coma si hay varios orígenes
CORS_ALLOWED_ORIGINS=http://localhost:5174

# WhatsApp — sin +, sin 0, sin 15 (ejemplo: 5493834625390)
WHATSAPP_NUMBER=549XXXXXXXXXX

# Email (para recuperar contraseña)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=

# Google OAuth — Login con Google
# 1. Ir a https://console.cloud.google.com/
# 2. Crear proyecto → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Tipo: "Web application"
# 4. Authorized JavaScript origins: https://tudominio.com
# 5. Authorized redirect URIs: NO necesitás URIs de callback (usamos ID Token en frontend)
# 6. Copiar el Client ID y pegarlo acá:
GOOGLE_CLIENT_ID=

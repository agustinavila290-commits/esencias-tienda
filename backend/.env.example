SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: True = SQLite (dev), False = PostgreSQL (prod)
USE_SQLITE=True

# PostgreSQL (solo si USE_SQLITE=False)
DB_NAME=esencias
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — separar con coma si hay varios orígenes. En producción, agregar
# también http://127.0.0.1:4173 (el prerenderizado usa vite preview en ese
# origen para pegarle a esta misma API — ver frontend/docs/PRERENDER.md).
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:4173

# CSRF — dominios permitidos para peticiones con cookies (agregar el dominio
# real de producción, con https://). Necesario para el login del panel admin.
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://localhost:5175

# WhatsApp — sin +, sin 0, sin 15 (ejemplo: 5493834625390)
WHATSAPP_NUMBER=549XXXXXXXXXX

# Email (para recuperar contraseña)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=

# Redis — opcional. Sin esto, cache y rate limiting usan memoria local del
# proceso (suficiente en dev o con un solo worker de Gunicorn). Con más de un
# worker en producción, configurar esto para que el rate limit y la caché de
# categorías se compartan entre todos los workers:
# REDIS_URL=redis://127.0.0.1:6379/1
REDIS_URL=

# Sentry — opcional, monitoreo de errores. Sin esto la app funciona igual,
# solo que sin reportar errores a ningún lado más que los logs locales.
SENTRY_DSN=

# Google OAuth — Login con Google
# 1. Ir a https://console.cloud.google.com/
# 2. Crear proyecto → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Tipo: "Web application"
# 4. Authorized JavaScript origins: https://tudominio.com
# 5. Authorized redirect URIs: NO necesitás URIs de callback (usamos ID Token en frontend)
# 6. Copiar el Client ID y pegarlo acá:
GOOGLE_CLIENT_ID=
